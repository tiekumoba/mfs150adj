# Frontend environment (Vite). Copy to .env.local for local development.
# Only VITE_-prefixed values are exposed to the browser: never put secrets here.

# Base URL of the backend API (Render Web Service in production)
VITE_API_URL=http://localhost:4000

# Clerk publishable key (pk_test_... / pk_live_...). Required. Safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=
