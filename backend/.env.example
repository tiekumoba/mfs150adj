# Neon connection string (Dashboard > Connect). Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# From your Clerk instance: https://<your-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=
# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev (no trailing slash)
CLERK_ISSUER=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
