# Backend environment. Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

# Origins allowed to call the API, comma-separated (the Vercel frontend URL in production)
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection string (use the pooled connection string), e.g.
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Clerk (not used yet)
CLERK_SECRET_KEY=
